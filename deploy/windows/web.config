<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS site configuration for School ERP. Copy this file into the root of the folder IIS serves (the built web app, client\dist).

  What it does
    1. /api/...   is passed on to the API service on this machine (127.0.0.1:4000).
    2. Any other address that is not a real file opens the web app (index.html), so links and refreshes inside the app work.
    3. Files are sent with sensible caching, and large uploads are allowed.

  What it needs on the server (IIS Manager > the server > modules; see docs\WINDOWS_IIS_DEPLOYMENT.md, step 4)
    - URL Rewrite  and  Application Request Routing, with "Enable proxy" ticked in ARR > Server Proxy Settings.
  Without them IIS answers 500 for every request under /api. If the API runs on another port, change 4000 below.
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>
        <rule name="API to the Node service" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:4000/api/{R:1}" appendQueryString="true" />
        </rule>
        <rule name="Web app (any other address)" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Uploads (documents, photos, restore files) up to 100 MB; the application applies its own, smaller limits -->
    <security>
      <requestFiltering removeServerHeader="true">
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <!-- browsers use this only over HTTPS; turn it on once the https:// binding works -->
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <!-- file names under /assets carry a fingerprint, so a browser can keep them a year -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

    <httpErrors existingResponse="PassThrough" />
  </system.webServer>

  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- the service worker and the page that loads everything must never be kept, or an update would not reach people -->
  <location path="sw.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
