# The global registry: one small service and database that lists every school (client) the mobile app can connect to.
PORT=4100
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=school_erp_global

# Needed to add, change or remove schools over the API (header x-admin-key). Use a long random value.
# Without it the admin API is off; the command line (npm run client) works either way.
GLOBAL_ADMIN_KEY=change_me_to_a_long_random_value

# Failed sign-ins one address may make in 15 minutes before it waits (default 200); 8 per mobile number or email.
# LOGIN_MAX_PER_ADDRESS=200

# Behind a reverse proxy, set TRUST_PROXY=1 so the rate limit sees each phone's real address.
# TRUST_PROXY=1
