PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=school_erp
JWT_SECRET=change_me
CLIENT_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@school.local
ADMIN_PASSWORD=admin123

SCHOOL_NAME=Your School Name

# Scheduled backup (a file in BACKUP_DIR; copy that folder off the server as well)
# BACKUP_DIR=backups
# BACKUP_EVERY_HOURS=24
# BACKUP_KEEP=14
# BACKUP_AUTO=off

# One mobile app for many schools: connect this school to the global registry (global/ in this project). The registry finds a person by
# mobile number or email, and this server reports its logins there. All three, or the feature is off. Get the key with:
#   npm run client -- key <school code>    (run in global/)
# GLOBAL_URL=http://localhost:4100/api
# GLOBAL_CLIENT_CODE=greenfield
# GLOBAL_CLIENT_KEY=
# GLOBAL_PUBLIC_KEY=   (optional: the registry's public signing key, to pin it instead of fetching it)

# Messaging. Leave blank to run in log-only mode: messages are recorded in the history but NOT delivered.
DEFAULT_COUNTRY_CODE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMS_PROVIDER=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
