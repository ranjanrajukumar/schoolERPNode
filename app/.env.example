# The School ERP API the app talks to. A phone cannot reach "localhost": use this computer's address on your Wi-Fi.
#   Android emulator:  http://10.0.2.2:4000/api
#   Real phone:        http://192.168.1.20:4000/api   (the server must be running, phone on the same Wi-Fi)
# It can also be changed on the sign-in screen ("Server address").
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000/api

# One app for many schools: the global registry (global/ in this project) finds a person's school from their mobile number or email.
# When this is set the app signs in through it, and EXPO_PUBLIC_API_URL above is not used. Leave it out to serve a single school.
# EXPO_PUBLIC_GLOBAL_URL=http://192.168.1.20:4100/api
